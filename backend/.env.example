# RenBI 360 API
DEMO_MODE=false
API_TOKEN=troque-por-token-seguro
CORS_ORIGINS=https://mauricio0910.github.io

# Fonte de dados: demo | sqlserver
RENBI_DATA_SOURCE=sqlserver

# Microsoft SQL Server - USE UMA CREDENCIAL SOMENTE LEITURA
SQL_ENABLED=true
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=SEU_SERVIDOR_OU_IP
SQL_PORT=1433
SQL_DATABASE=SEU_BANCO
SQL_USERNAME=renbi_readonly
SQL_PASSWORD=NAO_COLOQUE_SENHA_NO_GITHUB
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
SQL_CONNECTION_TIMEOUT=8
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS_PER_ENTITY=50000
# SQL_MAPPING_FILE=/caminho/seguro/sql_mapping.json
# SQL_SNAPSHOT_FILE=/caminho/persistente/sql_snapshot.json
